# Environment overrides for PiAutoRotate
# Copy this file to /etc/default/piautorotate and edit as needed.

# Wayland output name (e.g. HDMI-A-1, eDP-1, etc.)
# AUTOROTATE_OUTPUT=HDMI-A-1

# Seconds between sensor polls
# AUTOROTATE_INTERVAL=0.5

# Minimum g-force to decide a rotation
# AUTOROTATE_THRESHOLD=0.5

# Orientation to apply when the device is upright (normal/90/180/270)
# AUTOROTATE_DEFAULT_ROTATION=normal

# I2C bus number (1 on all modern Raspberry Pi boards)
# AUTOROTATE_BUS_ID=1
